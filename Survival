local function onPlayerAdded(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	ls.Parent = player
	for _, n in ipairs({ "Kayu", "Batu", "Kill" }) do
		local v = Instance.new("IntValue")
		v.Name = n
		v.Parent = ls
	end

	local st = { Hunger = 100, Thirst = 100, Token = 0, UI = buildGui(player) }
	state[player] = st

	player.CharacterAdded:Connect(function()
		st.Hunger, st.Thirst = 100, 100
		task.wait(1)
		notify(player, "Kumpulkan kayu & batu, lalu craft di meja dekat spawn!")
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(p) state[p] = nil end)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onPlayerAdded, p) end

-- lapar, haus, update HUD
task.spawn(function()
	while true do
		local dt = task.wait(0.25)
		for player, st in pairs(state) do
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				st.Hunger = math.max(0, st.Hunger - CFG.HungerDrain * dt)
				st.Thirst = math.max(0, st.Thirst - CFG.ThirstDrain * dt)
				if st.Hunger <= 0 or st.Thirst <= 0 then
					hum:TakeDamage(CFG.StarveDmg * dt)
				end
			end
			setBar(st.UI.Health, hum and hum.Health or 0, hum and hum.MaxHealth or 100)
			setBar(st.UI.Hunger, st.Hunger, 100)
			setBar(st.UI.Thirst, st.Thirst, 100)
		end
	end
end)

---------------------------------------------------------------- SIANG / MALAM
local day, isNight = 1, false
local clockSpeed = 24 / CFG.DayLength

task.spawn(function()
	while true do
		local dt = task.wait(0.25)
		local prev = Lighting.ClockTime
		Lighting.ClockTime = (prev + dt * clockSpeed) % 24
		if Lighting.ClockTime < prev then day += 1 end

		local ct = Lighting.ClockTime
		local nowNight = ct >= 18.5 or ct < 5.5
		if nowNight ~= isNight then
			isNight = nowNight
			if isNight then
				broadcast("Malam tiba! Zombie bermunculan...")
			else
				broadcast("Pagi tiba. Zombie terbakar!")
				for z, info in pairs(zombies) do
					z:SetAttribute("Attacker", nil)
					info.Hum.Health = 0
				end
			end
		end

		if isNight and zombieCount() < CFG.MaxZombies and rng:NextNumber() < 0.5 then
			spawnNearPlayer()
		end

		local txt = string.format("Hari %d  |  %02d:%02d  |  %s", day, math.floor(ct), math.floor((ct % 1) * 60),
			isNight and "Malam" or "Siang")
		for _, st in pairs(state) do st.UI.Time.Text = txt end
	end
end)
