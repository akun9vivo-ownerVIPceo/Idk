local function makeBar(parent, y, color, label)
	local back = Instance.new("Frame")
	back.Size = UDim2.fromOffset(220, 22)
	back.Position = UDim2.fromOffset(16, y)
	back.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	back.BackgroundTransparency = 0.3
	back.BorderSizePixel = 0
	back.Parent = parent
	Instance.new("UICorner", back).CornerRadius = UDim.new(0, 6)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = back
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 6)

	local txt = Instance.new("TextLabel")
	txt.Size = UDim2.fromScale(1, 1)
	txt.BackgroundTransparency = 1
	txt.TextColor3 = WHITE
	txt.Font = Enum.Font.GothamBold
	txt.TextSize = 13
	txt.ZIndex = 2
	txt.Parent = back
	return { Fill = fill, Label = txt, Name = label }
end

local function setBar(b, value, max)
	b.Fill.Size = UDim2.fromScale(math.clamp(value / max, 0, 1), 1)
	b.Label.Text = string.format("%s  %d", b.Name, math.floor(value))
end

