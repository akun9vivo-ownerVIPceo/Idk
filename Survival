---------------------------------------------------------------- HELPER
local function newPart(parent, name, size, pos, color, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	if shape then p.Shape = shape end
	p.Size = size
	p.Position = pos
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.Parent = parent
	return p
end

local function notify(player, msg)
	local st = state[player]
	if not st then return end
	st.Token += 1
	local t = st.Token
	st.UI.Notify.Text = msg
	st.UI.Notify.Visible = true
	task.delay(3, function()
		if st.Token == t then st.UI.Notify.Visible = false end
	end)
end

local function broadcast(msg)
	for p in pairs(state) do notify(p, msg) end
end

local function give(player, name, amt)
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(name)
	if v then v.Value += amt end
end

local function addNeed(player, key, amt)
	local st = state[player]
	if st then st[key] = math.clamp(st[key] + amt, 0, 100) end
end

local function setVisible(model, visible)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d:GetAttribute("T") == nil then
				d:SetAttribute("T", d.Transparency)
				d:SetAttribute("C", d.CanCollide)
			end
			d.Transparency = visible and d:GetAttribute("T") or 1
			d.CanCollide = visible and d:GetAttribute("C") or false
		end
	end
end

local function harvestable(model, anchor, action, objText, hold, cooldown, onGather)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = objText
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor
	prompt.Triggered:Connect(function(player)
		if not prompt.Enabled then return end
		prompt.Enabled = false
		setVisible(model, false)
		onGather(player)
		task.delay(cooldown, function()
			if model.Parent then
				setVisible(model, true)
				prompt.Enabled = true
			end
		end)
	end)
end

