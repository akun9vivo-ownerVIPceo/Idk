---------------------------------------------------------------- ZOMBIE
local function spawnZombie(pos)
	local m = Instance.new("Model")
	m.Name = "Zombie"
	m:SetAttribute("Zombie", true)

	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.MaxHealth = CFG.ZombieHP
	hum.Health = CFG.ZombieHP
	hum.WalkSpeed = CFG.ZombieSpeed
	hum.HipHeight = 1.5
	hum.BreakJointsOnDeath = false
	hum.Parent = m

	local skin = Color3.fromRGB(90, 140, 80)
	local function limb(name, size, offset, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.CFrame = CFrame.new(pos + offset)
		p.CanCollide = false
		p.Massless = true
		p.Parent = m
		return p
	end

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 3, 1)
	root.Color = Color3.fromRGB(60, 90, 140)
	root.CFrame = CFrame.new(pos)
	root.Parent = m
	m.PrimaryPart = root

	local parts = {
		limb("Head", Vector3.new(1.6, 1.6, 1.6), Vector3.new(0, 2.3, 0), skin),
		limb("ArmL", Vector3.new(0.8, 0.8, 2.5), Vector3.new(-1.4, 0.7, -1.2), skin),
		limb("ArmR", Vector3.new(0.8, 0.8, 2.5), Vector3.new(1.4, 0.7, -1.2), skin),
		limb("LegL", Vector3.new(0.9, 1.5, 0.9), Vector3.new(-0.5, -2.25, 0), Color3.fromRGB(40, 60, 100)),
		limb("LegR", Vector3.new(0.9, 1.5, 0.9), Vector3.new(0.5, -2.25, 0), Color3.fromRGB(40, 60, 100)),
	}
	for _, p in ipairs(parts) do
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = root
	end

	m.Parent = world
	root:SetNetworkOwner(nil)

	zombies[m] = { Hum = hum, Root = root, LastAtk = 0 }

	hum.Died:Connect(function()
		local killer = Players:GetPlayerByUserId(m:GetAttribute("Attacker") or 0)
		if killer then give(killer, "Kill", 1) end
		zombies[m] = nil
		Debris:AddItem(m, 2)
	end)
end

local function zombieCount()
	local n = 0
	for _ in pairs(zombies) do n += 1 end
	return n
end

local function spawnNearPlayer()
	local list = Players:GetPlayers()
	if #list == 0 then return end
	local p = list[rng:NextInteger(1, #list)]
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local ang = rng:NextNumber(0, math.pi * 2)
	local dist = rng:NextNumber(45, 75)
	local lim = CFG.MapSize / 2 - 10
	local x = math.clamp(root.Position.X + math.cos(ang) * dist, -lim, lim)
	local z = math.clamp(root.Position.Z + math.sin(ang) * dist, -lim, lim)
	spawnZombie(Vector3.new(x, 4, z))
end

-- AI zombie
task.spawn(function()
	while true do
		task.wait(0.4)
		for z, info in pairs(zombies) do
			local hum, root = info.Hum, info.Root
			if not z.Parent or hum.Health <= 0 then
				zombies[z] = nil
			else
				local nearest, nd = nil, 70
				for _, p in ipairs(Players:GetPlayers()) do
					local c = p.Character
					local r = c and c:FindFirstChild("HumanoidRootPart")
					local h = c and c:FindFirstChildOfClass("Humanoid")
					if r and h and h.Health > 0 then
						local d = (r.Position - root.Position).Magnitude
						if d < nd then nearest, nd = p, d end
					end
				end
				if nearest then
					local tr = nearest.Character.HumanoidRootPart
					hum:MoveTo(tr.Position)
					if nd > 5 and root.AssemblyLinearVelocity.Magnitude < 2 then
						hum.Jump = true
					end
					if nd < 4.5 and os.clock() - info.LastAtk > 1 then
						info.LastAtk = os.clock()
						nearest.Character.Humanoid:TakeDamage(CFG.ZombieDmg)
					end
				elseif rng:NextInteger(1, 4) == 1 then
					hum:MoveTo(root.Position + Vector3.new(rng:NextInteger(-20, 20), 0, rng:NextInteger(-20, 20)))
				end
			end
		end
	end
end)

---------------------------------------------------------------- CRAFTING
local function giveSword(player)
	local has = player.Backpack:FindFirstChild("Pedang")
		or (player.Character and player.Character:FindFirstChild("Pedang"))
	if has then return false, "Kamu sudah punya Pedang!" end

	local tool = Instance.new("Tool")
	tool.Name = "Pedang"
	tool.CanBeDropped = false
	tool.GripPos = Vector3.new(0, 0, -1.5)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1, 0.8, 4)
	handle.Color = Color3.fromRGB(190, 190, 200)
	handle.Material = Enum.Material.Metal
	handle.Parent = tool

	local last = 0
	tool.Activated:Connect(function()
		local char = tool.Parent
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root or os.clock() - last < 0.5 then return end
		last = os.clock()
		local center = root.Position + root.CFrame.LookVector * 4
		local hit = {}
		for _, part in ipairs(workspace:GetPartBoundsInRadius(center, 6)) do
			local model = part:FindFirstAncestorOfClass("Model")
			if model and model:GetAttribute("Zombie") and not hit[model] then
				hit[model] = true
				local zh = model:FindFirstChildOfClass("Humanoid")
				if zh and zh.Health > 0 then
					model:SetAttribute("Attacker", player.UserId)
					zh:TakeDamage(CFG.SwordDmg)
				end
			end
		end
	end)

	tool.Parent = player.Backpack
	return true, "Pedang berhasil dibuat!"
end

local function placeCampfire(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return false, "Karakter belum siap" end

	local pos = root.Position + root.CFrame.LookVector * 5
	local rp = RaycastParams.new()
	rp.FilterDescendantsInstances = { char }
	local r = workspace:Raycast(pos + Vector3.new(0, 10, 0), Vector3.new(0, -40, 0), rp)
	local gy = r and r.Position.Y or 0

	local fire = newPart(world, "Api Unggun", Vector3.new(3, 1, 3), Vector3.new(pos.X, gy + 0.5, pos.Z),
		Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
	local f = Instance.new("Fire")
	f.Size = 8
	f.Heat = 10
	f.Parent = fire
	local l = Instance.new("PointLight")
	l.Range = 24
	l.Brightness = 3
	l.Color = Color3.fromRGB(255, 170, 80)
	l.Parent = fire

	task.spawn(function()
		for _ = 1, CFG.CampfireLife do
			if not fire.Parent then return end
			for _, p in ipairs(Players:GetPlayers()) do
				local c = p.Character
				local h = c and c:FindFirstChildOfClass("Humanoid")
				local r2 = c and c:FindFirstChild("HumanoidRootPart")
				if h and h.Health > 0 and r2 and (r2.Position - fire.Position).Magnitude < 14 then
					h.Health = math.min(h.MaxHealth, h.Health + 3)
				end
			end
			for _, info in pairs(zombies) do
				if (info.Root.Position - fire.Position).Magnitude < 12 then
					info.Hum:TakeDamage(6)
				end
			end
			task.wait(1)
		end
		fire:Destroy()
	end)
	return true, "Api unggun menyala! (heal + bakar zombie)"
end

local function makeStation(name, pos, color, costWood, costStone, craft)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = world
	local base = newPart(m, "Base", Vector3.new(6, 3, 3), pos + Vector3.new(0, 1.5, 0), color, Enum.Material.Wood)

	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(220, 50)
	tag.StudsOffset = Vector3.new(0, 3, 0)
	tag.AlwaysOnTop = true
	tag.Adornee = base
	tag.Parent = base
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.TextColor3 = WHITE
	tl.TextStrokeTransparency = 0.4
	tl.Font = Enum.Font.GothamBold
	tl.TextScaled = true
	tl.Text = string.format("%s\n%d Kayu + %d Batu", name, costWood, costStone)
	tl.Parent = tag

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Buat"
	prompt.ObjectText = name
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	prompt.Triggered:Connect(function(player)
		local ls = player:FindFirstChild("leaderstats")
		if not ls then return end
		if ls.Kayu.Value < costWood or ls.Batu.Value < costStone then
			notify(player, "Bahan kurang! Butuh " .. costWood .. " Kayu & " .. costStone .. " Batu")
			return
		end
		local ok, msg = craft(player)
		if ok then
			ls.Kayu.Value -= costWood
			ls.Batu.Value -= costStone
		end
		notify(player, msg)
	end)
end

makeStation("Meja Pedang",     Vector3.new(14, 0, -10), Color3.fromRGB(130, 90, 55), 5, 3, giveSword)
makeStation("Meja Api Unggun", Vector3.new(14, 0, -20), Color3.fromRGB(150, 70, 40), 4, 2, placeCampfire)

