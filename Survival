local function randomSpot()
	local h = CFG.MapSize / 2 - 15
	for _ = 1, 30 do
		local x, z = rng:NextNumber(-h, h), rng:NextNumber(-h, h)
		local nearSpawn = (x * x + z * z) < 30 * 30
		local nearPond = ((x - POND.X) ^ 2 + (z - POND.Z) ^ 2) < 18 * 18
		if not nearSpawn and not nearPond then return x, z end
	end
	return 100, 100
end

